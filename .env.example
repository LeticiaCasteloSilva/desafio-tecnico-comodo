# Parte 1 - Ingestao da API do GitHub
# Token pessoal (classic ou fine-grained), gerado em:
#   https://github.com/settings/tokens
# Para ler repositorios publicos nao e necessario nenhum escopo marcado.
GITHUB_TOKEN=

# Organizacao alvo da coleta (padrao: vercel)
GITHUB_ORG=vercel

# API KEY OpenAI para classificação de leads com LLM 
OPENAI_API_KEY=

